<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hover.last.sale.price</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Settings layout: <app>/<block>/<setting> (unchanged in 18.0). -->
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Last Sale Price" name="lsp_settings_container">
                    <setting id="lsp_enabled_setting"
                             help="Reuse the prices previously charged to each customer on sales order lines.">
                        <field name="lsp_enabled"/>
                    </setting>
                    <setting id="lsp_hover_setting" invisible="not lsp_enabled"
                             help="Hover over the product or the history icon beside the unit price to see the customer's recent prices.">
                        <field name="lsp_hover_enabled"/>
                        <div class="content-group mt-2" invisible="not lsp_hover_enabled">
                            <label for="lsp_hover_limit" class="o_light_label me-2"/>
                            <field name="lsp_hover_limit" class="oe_inline" style="width: 4rem;"
                                   required="lsp_enabled and lsp_hover_enabled"/>
                        </div>
                    </setting>
                    <setting id="lsp_suggest_setting" invisible="not lsp_enabled"
                             help="Fill the unit price with the customer's last price for the product, converted to the line's unit of measure and currency.">
                        <field name="lsp_suggest_enabled"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

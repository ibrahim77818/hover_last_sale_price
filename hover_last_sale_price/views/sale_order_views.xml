<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The product hover replaces the standard "sol_product_many2one" field
         widget in JS, so the product column needs no view change (and it
         stays compatible with the product configurator / matrix, which patch
         the same component). The order exposes the technical flag and the
         unit price gets the history icon widget. 18.0 renamed <tree> to <list>. -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.hover.last.sale.price</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="lsp_hover_enabled" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="widget">lsp_price_unit</attribute>
            </xpath>
        </field>
    </record>
</odoo>

#. module: hover_last_sale_price
#: model:ir.model.fields,help:hover_last_sale_price.field_res_company__lsp_suggest_enabled
#: model:ir.model.fields,help:hover_last_sale_price.field_res_config_settings__lsp_suggest_enabled
msgid "Automatically fill the unit price of a new sales order line with the price last charged to the customer for that product."
msgstr "تعبئة سعر الوحدة تلقائيًا في بند أمر البيع الجديد بآخر سعر تم تحصيله من العميل لهذا المنتج."


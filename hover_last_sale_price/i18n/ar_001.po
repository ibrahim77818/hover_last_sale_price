#. module: hover_last_sale_price
#: model:ir.model.fields,help:hover_last_sale_price.field_res_company__lsp_hover_enabled
#: model:ir.model.fields,help:hover_last_sale_price.field_res_config_settings__lsp_hover_enabled
msgid "Display a popup with the customer's previous prices when hovering over the product of a sales order line."
msgstr "عرض نافذة منبثقة بأسعار العميل السابقة عند تمرير المؤشر فوق منتج بند أمر البيع."

#. module: hover_last_sale_price
#: model_terms:ir.ui.view,arch_db:hover_last_sale_price.res_config_settings_view_form
msgid "Fill the unit price with the customer's last price for the product, converted to the line's unit of measure and currency."
msgstr "تعبئة سعر الوحدة بآخر سعر للعميل لهذا المنتج، بعد تحويله إلى وحدة القياس والعملة الخاصة بالبند."

#. module: hover_last_sale_price
#: model_terms:ir.ui.view,arch_db:hover_last_sale_price.res_config_settings_view_form
msgid "Hover over the product or the history icon beside the unit price to see the customer's recent prices."
msgstr "مرّر المؤشر فوق المنتج أو أيقونة السجل بجوار سعر الوحدة لعرض أحدث أسعار العميل."

#. module: hover_last_sale_price
#. odoo-javascript
#: code:addons/hover_last_sale_price/static/src/js/last_sale_price_hover.js:0
msgid "Hover to see the customer's last sale prices"
msgstr "مرّر المؤشر لعرض آخر أسعار البيع لهذا العميل"


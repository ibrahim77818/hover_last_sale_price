#: code:addons/hover_last_sale_price/static/src/xml/last_sale_price_popover.xml:0
msgid "Converted to this line's unit of measure and currency"
msgstr "محوَّل إلى وحدة القياس والعملة الخاصة بهذا البند"

#. module: hover_last_sale_price
#. odoo-javascript
#: code:addons/hover_last_sale_price/static/src/xml/last_sale_price_popover.xml:0
msgid "Date"
msgstr "التاريخ"

